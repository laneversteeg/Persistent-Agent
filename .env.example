# Copy to .env (gitignored). `mda deploy` uploads every non-empty value as a deployment
# secret, except LANGSMITH_API_KEY.

LANGSMITH_API_KEY=
# Needed if your key is organization-scoped.
# LANGSMITH_WORKSPACE_ID=

# Model. The default runs through the LangSmith LLM Gateway, so no other key is needed
# once the workspace has an Anthropic provider secret. Or call a provider directly:
# AGENT_MODEL=langsmith:anthropic/claude-opus-5-5
# AGENT_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=
# AGENT_MODEL=openai:gpt-5.5
# OPENAI_API_KEY=

# Tool Gateway: a kit's MCP URL (LangSmith -> Tools -> your kit), such as
# https://api.smith.langchain.com/v1/managed-tools/kits/<kit-id>/mcp. Tools run as the
# person talking; set TOOLS_PROFILE to use a profile's own accounts instead.
# TOOLS_MCP_URL=
# TOOLS_PROFILE=
