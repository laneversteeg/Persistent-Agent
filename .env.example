# Copy to .env (gitignored), fill in the required values, then run `uv run mda deploy`.
# `mda deploy` uploads every non-empty value as a deployment secret, except
# LANGSMITH_API_KEY. Slack needs nothing here: the first deploy prints a link to approve the app.

# --- Required ---

# LangSmith API key for the workspace you deploy to (LangSmith -> Settings -> API Keys).
LANGSMITH_API_KEY=

# Tool Gateway kit's MCP URL (LangSmith -> Tools -> your kit), such as
# https://api.smith.langchain.com/v1/managed-tools/kits/<kit-id>/mcp
# Without it the agent deploys but has no integrations (Google, Slack, Linear, GitHub...).
TOOLS_MCP_URL=

# --- Optional ---

# Needed if your API key is organization-scoped.
# LANGSMITH_WORKSPACE_ID=

# Integrations run as the person talking. Set a profile to use its accounts for everyone instead.
# TOOLS_PROFILE=

# Model. Leave these unset to run Claude Opus 5.5 through the LangSmith LLM Gateway (needs an
# Anthropic provider secret in the workspace, no other key). To call a provider directly,
# uncomment one pair:
#
# Anthropic:
# AGENT_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=
#
# OpenAI:
# AGENT_MODEL=openai:gpt-6.2-sol
# OPENAI_API_KEY=

# Slack reactions use a small, fast model: Haiku through the LLM Gateway by default, or
# AGENT_MODEL when you call a provider directly. Override it here.
# REACTION_MODEL=langsmith:anthropic/claude-haiku-5-5
